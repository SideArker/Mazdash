<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme: DayNight so the app follows light/dark.
         Centralized styling references the global Mazdash design tokens. -->
    <style name="Theme.RadioLauncher" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Theme.Mazdash alias -->
    <style name="Theme.Mazdash" parent="Theme.RadioLauncher" />
</resources>
