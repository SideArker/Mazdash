<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <include
        android:id="@+id/header"
        layout="@layout/view_page_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Left Column: Sound Stage / Fader & Balance -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/card_dark"
            android:padding="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dsp_sound_stage"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:layout_marginBottom="8dp" />

            <com.dashline.launcher.MazdaSoundStageView
                android:id="@+id/soundStageView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnStageCenter"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="@string/dsp_preset_center"
                    android:textSize="11sp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/btn_circle"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnStageDriver"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="@string/dsp_preset_driver"
                    android:textSize="11sp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/btn_circle"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnStageCopilot"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="@string/dsp_preset_copilot"
                    android:textSize="11sp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/btn_circle"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnStageRear"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="@string/dsp_preset_rear"
                    android:textSize="11sp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/btn_circle" />

            </LinearLayout>

        </LinearLayout>

        <!-- Right Column: Equalizer & Subwoofer -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:background="@drawable/card_dark"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dsp_equalizer"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:layout_marginBottom="8dp" />

                <!-- Bass Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="@string/dsp_bass"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <SeekBar
                        android:id="@+id/seekBass"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="14"
                        android:progress="7"
                        android:progressDrawable="@drawable/seek_progress"
                        android:thumb="@drawable/seek_thumb" />

                    <TextView
                        android:id="@+id/textBassVal"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="0"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Tenor / Midrange Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="@string/dsp_tenor"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <SeekBar
                        android:id="@+id/seekTenor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="14"
                        android:progress="7"
                        android:progressDrawable="@drawable/seek_progress"
                        android:thumb="@drawable/seek_thumb" />

                    <TextView
                        android:id="@+id/textTenorVal"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="0"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Treble Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="@string/dsp_treble"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <SeekBar
                        android:id="@+id/seekTreble"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="14"
                        android:progress="7"
                        android:progressDrawable="@drawable/seek_progress"
                        android:thumb="@drawable/seek_thumb" />

                    <TextView
                        android:id="@+id/textTrebleVal"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="0"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Subwoofer Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="@string/dsp_heavy_bass"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <SeekBar
                        android:id="@+id/seekHeavyBass"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="14"
                        android:progress="0"
                        android:progressDrawable="@drawable/seek_progress"
                        android:thumb="@drawable/seek_thumb" />

                    <TextView
                        android:id="@+id/textHeavyBassVal"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="0"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Loudness Switch & Presets -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dsp_loudness"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchLoudness"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- EQ Presets -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnEqStandard"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="@string/dsp_mode_standard"
                        android:textSize="10sp"
                        android:textColor="@android:color/white"
                        android:background="@drawable/btn_circle"
                        android:layout_marginEnd="2dp" />

                    <Button
                        android:id="@+id/btnEqPop"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="@string/dsp_mode_pop"
                        android:textSize="10sp"
                        android:textColor="@android:color/white"
                        android:background="@drawable/btn_circle"
                        android:layout_marginEnd="2dp" />

                    <Button
                        android:id="@+id/btnEqRock"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="@string/dsp_mode_rock"
                        android:textSize="10sp"
                        android:textColor="@android:color/white"
                        android:background="@drawable/btn_circle"
                        android:layout_marginEnd="2dp" />

                    <Button
                        android:id="@+id/btnEqClassic"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="@string/dsp_mode_classic"
                        android:textSize="10sp"
                        android:textColor="@android:color/white"
                        android:background="@drawable/btn_circle"
                        android:layout_marginEnd="2dp" />

                    <Button
                        android:id="@+id/btnEqJazz"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="@string/dsp_mode_jazz"
                        android:textSize="10sp"
                        android:textColor="@android:color/white"
                        android:background="@drawable/btn_circle" />
                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</LinearLayout>
