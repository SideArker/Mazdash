<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Top Navigation Header with Tabs -->
    <LinearLayout
        style="@style/Mazdash.Header">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/navBack"
            style="@style/Mazdash.Button.Icon"
            android:contentDescription="@string/nav_back"
            app:srcCompat="@drawable/ic_back" />

        <TextView
            android:id="@+id/pageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/mazda_dsp_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Segmented Tab Switch: KABINA vs EQUALIZER -->
        <LinearLayout
            style="@style/Mazdash.Header.SegmentedTab"
            android:layout_marginEnd="8dp">

            <Button
                android:id="@+id/tabCabin"
                style="@style/Mazdash.Header.TabButton.Active"
                android:text="KABINA" />

            <Button
                android:id="@+id/tabEqualizer"
                style="@style/Mazdash.Header.TabButton.Inactive"
                android:text="EQUALIZER" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/navHome"
            style="@style/Mazdash.Button.Icon"
            android:contentDescription="@string/nav_home"
            app:srcCompat="@drawable/ic_home" />

    </LinearLayout>

    <!-- Main Content Pages -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===== PAGE 1: KABINA (SOUND STAGE & FADER) ===== -->
        <LinearLayout
            android:id="@+id/pageCabin"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="visible">

            <!-- Left: Cabin View with Car Seats & Touch Crosshair -->
            <LinearLayout
                style="@style/Mazdash.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_marginEnd="10dp">

                <TextView
                    style="@style/Mazdash.Text.SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SCENA DŹWIĘKOWA (DOTKNIJ W KABINIE)" android:layout_marginBottom="6dp" />

                <com.dashline.launcher.MazdaSoundStageView
                    android:id="@+id/soundStageView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </LinearLayout>

            <!-- Right: Quick Stage Buttons & Readout -->
            <LinearLayout
                style="@style/Mazdash.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.8"
                android:orientation="vertical">

                <TextView
                    style="@style/Mazdash.Text.SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SZYBKIE POZYCJE" android:layout_marginBottom="10dp" />

                <!-- Stage Position readout -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/tile_bg"
                    android:padding="10dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/textFaderStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fader: Środek (0)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textBalanceStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Balance: Środek (0)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnStageCenter"
                    style="@style/Mazdash.Button.Stage.Active"
                    android:text="CAŁE AUTO (ŚRODEK)" />

                <Button
                    android:id="@+id/btnStageDriver"
                    style="@style/Mazdash.Button.Stage"
                    android:text="KIEROWCA" />

                <Button
                    android:id="@+id/btnStageCopilot"
                    style="@style/Mazdash.Button.Stage"
                    android:text="PASAŻER" />

                <Button
                    android:id="@+id/btnStageRear"
                    style="@style/Mazdash.Button.Stage"
                    android:text="TYŁ" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnStageReset"
                    style="@style/Mazdash.Button.Rounded"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:text="WYŚRODKUJ"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- ===== PAGE 2: EQUALIZER (8 VERTICAL BANDS + STEPPERS) ===== -->
        <LinearLayout
            android:id="@+id/pageEqualizer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">

            <!-- Left: 8 Vertical Slider Columns + Profile Chips -->
            <LinearLayout
                style="@style/Mazdash.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.6"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginEnd="10dp">

                <TextView
                    style="@style/Mazdash.Text.SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KOREKTOR GRAFICZNY (8-PASMOWY)" android:layout_marginBottom="6dp" />

                <!-- 8 Vertical Sliders Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Band 1: 60 Hz -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="2dp">

                        <TextView
                            android:id="@+id/textEqVal0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 dB"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.dashline.launcher.MazdaVerticalSlider
                            android:id="@+id/sliderEq0"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <!-- - and + Steppers -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="2dp">
                            <Button
                                android:id="@+id/btnEq0Minus"
                                style="@style/Mazdash.Button.Stepper"
                                android:text="−" />
                            <Button
                                android:id="@+id/btnEq0Plus"
                                style="@style/Mazdash.Button.Stepper"
                                android:layout_marginStart="2dp"
                                android:text="+" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="60Hz"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Band 2: 150 Hz -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="2dp">

                        <TextView
                            android:id="@+id/textEqVal1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 dB"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.dashline.launcher.MazdaVerticalSlider
                            android:id="@+id/sliderEq1"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="2dp">
                            <Button
                                android:id="@+id/btnEq1Minus"
                                style="@style/Mazdash.Button.Stepper"
                                android:text="−" />
                            <Button
                                android:id="@+id/btnEq1Plus"
                                style="@style/Mazdash.Button.Stepper"
                                android:layout_marginStart="2dp"
                                android:text="+" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="150Hz"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Band 3: 400 Hz -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="2dp">

                        <TextView
                            android:id="@+id/textEqVal2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 dB"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.dashline.launcher.MazdaVerticalSlider
                            android:id="@+id/sliderEq2"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="2dp">
                            <Button
                                android:id="@+id/btnEq2Minus"
                                style="@style/Mazdash.Button.Stepper"
                                android:text="−" />
                            <Button
                                android:id="@+id/btnEq2Plus"
                                style="@style/Mazdash.Button.Stepper"
                                android:layout_marginStart="2dp"
                                android:text="+" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="400Hz"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Band 4: 1 kHz -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="2dp">

                        <TextView
                            android:id="@+id/textEqVal3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 dB"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.dashline.launcher.MazdaVerticalSlider
                            android:id="@+id/sliderEq3"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="2dp">
                            <Button
                                android:id="@+id/btnEq3Minus"
                                style="@style/Mazdash.Button.Stepper"
                                android:text="−" />
                            <Button
                                android:id="@+id/btnEq3Plus"
                                style="@style/Mazdash.Button.Stepper"
                                android:layout_marginStart="2dp"
                                android:text="+" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1kHz"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Band 5: 2.5 kHz -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="2dp">

                        <TextView
                            android:id="@+id/textEqVal4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 dB"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.dashline.launcher.MazdaVerticalSlider
                            android:id="@+id/sliderEq4"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="2dp">
                            <Button
                                android:id="@+id/btnEq4Minus"
                                style="@style/Mazdash.Button.Stepper"
                                android:text="−" />
                            <Button
                                android:id="@+id/btnEq4Plus"
                                style="@style/Mazdash.Button.Stepper"
                                android:layout_marginStart="2dp"
                                android:text="+" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2.5k"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Band 6: 6 kHz -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="2dp">

                        <TextView
                            android:id="@+id/textEqVal5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 dB"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.dashline.launcher.MazdaVerticalSlider
                            android:id="@+id/sliderEq5"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="2dp">
                            <Button
                                android:id="@+id/btnEq5Minus"
                                style="@style/Mazdash.Button.Stepper"
                                android:text="−" />
                            <Button
                                android:id="@+id/btnEq5Plus"
                                style="@style/Mazdash.Button.Stepper"
                                android:layout_marginStart="2dp"
                                android:text="+" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="6kHz"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Band 7: 10 kHz -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="2dp">

                        <TextView
                            android:id="@+id/textEqVal6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 dB"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.dashline.launcher.MazdaVerticalSlider
                            android:id="@+id/sliderEq6"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="2dp">
                            <Button
                                android:id="@+id/btnEq6Minus"
                                style="@style/Mazdash.Button.Stepper"
                                android:text="−" />
                            <Button
                                android:id="@+id/btnEq6Plus"
                                style="@style/Mazdash.Button.Stepper"
                                android:layout_marginStart="2dp"
                                android:text="+" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10kHz"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Band 8: 14 kHz -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="2dp">

                        <TextView
                            android:id="@+id/textEqVal7"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 dB"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.dashline.launcher.MazdaVerticalSlider
                            android:id="@+id/sliderEq7"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="2dp">
                            <Button
                                android:id="@+id/btnEq7Minus"
                                style="@style/Mazdash.Button.Stepper"
                                android:text="−" />
                            <Button
                                android:id="@+id/btnEq7Plus"
                                style="@style/Mazdash.Button.Stepper"
                                android:layout_marginStart="2dp"
                                android:text="+" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="14kHz"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Profile Selection Below Sliders -->
                <TextView
                    style="@style/Mazdash.Text.SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROFILE DŹWIĘKU" android:layout_marginTop="6dp" android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnEqStandard"
                        style="@style/Mazdash.Button.Chip.Active" android:layout_marginEnd="3dp"
                        android:text="Standard" />

                    <Button
                        android:id="@+id/btnEqPop"
                        style="@style/Mazdash.Button.Chip" android:layout_marginEnd="3dp"
                        android:text="Pop" />

                    <Button
                        android:id="@+id/btnEqRock"
                        style="@style/Mazdash.Button.Chip" android:layout_marginEnd="3dp"
                        android:text="Rock" />

                    <Button
                        android:id="@+id/btnEqClassic"
                        style="@style/Mazdash.Button.Chip" android:layout_marginEnd="3dp"
                        android:text="Klasyka" />

                    <Button
                        android:id="@+id/btnEqJazz"
                        style="@style/Mazdash.Button.Chip"
                        android:text="Jazz" />
                </LinearLayout>

            </LinearLayout>

            <!-- Right: Loudness Toggle & Subwoofer -->
            <LinearLayout
                style="@style/Mazdash.Card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.8"
                android:orientation="vertical">

                <TextView
                    style="@style/Mazdash.Text.SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DYNAMIKA DŹWIĘKU" android:layout_marginBottom="10dp" />

                <!-- Loudness Toggle Box (Underneath tab switch on the right) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/tile_bg"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Loudness"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchLoudness"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wzmocnienie dynamiki i konturu basu przy cichym odsłuchu."
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Subwoofer Gain Control -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/tile_bg"
                    android:padding="10dp"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Subwoofer"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textHeavyBassVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+0"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <Button
                            android:id="@+id/btnSubMinus"
                            style="@style/Mazdash.Button.Stepper.Large"
                            android:text="−" />

                        <SeekBar
                            android:id="@+id/seekHeavyBass"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="14"
                            android:progress="0"
                            android:progressDrawable="@drawable/seek_progress"
                            android:thumb="@drawable/seek_thumb"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/btnSubPlus"
                            style="@style/Mazdash.Button.Stepper.Large"
                            android:text="+" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnResetEq"
                    style="@style/Mazdash.Button.Rounded"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:text="ZERUJ KOREKTOR (0 dB)"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
