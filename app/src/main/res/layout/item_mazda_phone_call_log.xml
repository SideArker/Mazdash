<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Mazdash.Tile"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginBottom="6dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="12dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iconCallType"
        style="@style/Mazdash.Button.Icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="6dp"
        app:srcCompat="@drawable/ic_history"
        app:tint="@color/mz_accent"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textCallerName"
            style="@style/Mazdash.Text.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textCallerNumber"
                style="@style/Mazdash.Text.CardSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/textCallDate"
                style="@style/Mazdash.Text.CardSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mz_text_muted"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btnRedial"
        style="@style/Mazdash.Button.Icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:padding="8dp"
        android:background="@drawable/btn_pill"
        android:backgroundTint="@color/mz_status_connected"
        app:srcCompat="@drawable/ic_call"
        app:tint="@android:color/white" />

</LinearLayout>
