<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <include
        android:id="@+id/header"
        layout="@layout/view_page_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Left Column: Radio Settings & Pairing Mode -->
        <LinearLayout
            style="@style/Mazdash.Card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                style="@style/Mazdash.Text.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bt_device_name_label"
                android:layout_marginBottom="4dp" />

            <!-- Device Name Row -->
            <LinearLayout
                style="@style/Mazdash.Tile"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:paddingEnd="8dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/textLocalBtName"
                    style="@style/Mazdash.Text.CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mazda"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnChangeName"
                    style="@style/Mazdash.Button.Rounded"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="@string/bt_change_name"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- PIN Code Row -->
            <TextView
                style="@style/Mazdash.Text.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bt_pin_code_label"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                style="@style/Mazdash.Tile"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:paddingEnd="8dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/textBtPin"
                    style="@style/Mazdash.Text.CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0000"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnChangePin"
                    style="@style/Mazdash.Button.Rounded"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="@string/bt_change_pin"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Big Start Pairing Mode Button (Mazdash Soul Red Pill) -->
            <Button
                android:id="@+id/btnStartPairing"
                style="@style/Mazdash.Button.Pill"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/bt_pairing_mode"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textPairingInstructions"
                style="@style/Mazdash.Text.CardSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="12dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Nearby Discovery Button -->
            <Button
                android:id="@+id/btnStartDiscovery"
                style="@style/Mazdash.Button.Rounded"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="Szukaj urządzeń w pobliżu"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Right Column: Paired Devices List -->
        <LinearLayout
            style="@style/Mazdash.Card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    style="@style/Mazdash.Text.SectionLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/bt_paired_devices" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnRefreshDevices"
                    style="@style/Mazdash.Button.Icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="6dp"
                    app:srcCompat="@drawable/ic_reset" />

            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerPairedDevices"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="vertical" />

                <TextView
                    android:id="@+id/textEmptyPaired"
                    style="@style/Mazdash.Text.CardSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/bt_no_paired_devices"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
