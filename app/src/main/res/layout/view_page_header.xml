<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared header for secondary pages: in-app Back / Home controls plus a title.
  Uses global Mazdash component styles.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Mazdash.Header">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/navBack"
        style="@style/Mazdash.Button.Icon"
        android:contentDescription="@string/nav_back"
        app:srcCompat="@drawable/ic_back" />

    <TextView
        android:id="@+id/pageTitle"
        style="@style/Mazdash.Text.HeaderTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:text="@string/app_name" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/navHome"
        style="@style/Mazdash.Button.Icon"
        android:contentDescription="@string/nav_home"
        app:srcCompat="@drawable/ic_home" />

</LinearLayout>
