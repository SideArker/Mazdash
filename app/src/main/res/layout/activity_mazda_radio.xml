<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Top Navigation Header -->
    <LinearLayout
        style="@style/Mazdash.Header">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/navBack"
            style="@style/Mazdash.Button.Icon"
            android:contentDescription="@string/nav_back"
            app:srcCompat="@drawable/ic_back" />

        <TextView
            android:id="@+id/pageTitle"
            style="@style/Mazdash.Text.HeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="Radio FM / AM" />

        <!-- Sound DSP Shortcut -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnOpenDsp"
            style="@style/Mazdash.Button.Icon"
            android:contentDescription="@string/mazda_dsp_title"
            app:srcCompat="@drawable/ic_equalizer" />

        <!-- Bluetooth Manager Shortcut -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnOpenBluetooth"
            style="@style/Mazdash.Button.Icon"
            android:contentDescription="@string/mazda_bt_title"
            app:srcCompat="@drawable/ic_bluetooth" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/navHome"
            style="@style/Mazdash.Button.Icon"
            android:visibility="gone"
            android:contentDescription="@string/nav_home"
            app:srcCompat="@drawable/ic_home" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Left Column: Tuner Display & Controls -->
        <LinearLayout
            style="@style/Mazdash.Card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginEnd="8dp">

            <!-- Band & Stereo Status Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/textRadioBand"
                    style="@style/Mazdash.Button.Chip.Active"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="FM1" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/textStereoBadge"
                    style="@style/Mazdash.Text.SectionLabel.Accent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STEREO"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/textRdsBadge"
                    style="@style/Mazdash.Text.SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RDS" />

            </LinearLayout>

            <!-- Main Frequency Digital Readout -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="2dp">

                <TextView
                    android:id="@+id/textFrequency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="105.60"
                    android:textColor="@color/mz_accent"
                    android:textSize="54sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/textFreqUnit"
                    style="@style/Mazdash.Text.CardSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="MHz"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- RDS Station PS Name -->
            <TextView
                android:id="@+id/textStationName"
                style="@style/Mazdash.Text.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RMF FM"
                android:textSize="22sp"
                android:layout_marginBottom="4dp" />

            <!-- RadioText (RT) Message -->
            <TextView
                android:id="@+id/textRtMessage"
                style="@style/Mazdash.Text.CardSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="marquee"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:text="Najlepsza Muzyka - RMF FM"
                android:layout_marginBottom="12dp" />

            <!-- Real-Time Audio Visualizer (16 Bars) -->
            <com.dashline.launcher.AudioVisualizerView
                android:id="@+id/radioVisualizer"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="14dp" />

            <!-- Tuning Controls Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnSeekDown"
                    style="@style/Mazdash.Button.Rounded"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="&lt;&lt;"
                    android:textSize="14sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnStepDown"
                    style="@style/Mazdash.Button.Rounded"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="&lt;"
                    android:textSize="16sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnBandToggle"
                    style="@style/Mazdash.Button.Pill"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1.2"
                    android:text="BAND"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnAmsScan"
                    style="@style/Mazdash.Button.Rounded"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1.1"
                    android:text="AMS"
                    android:textSize="13sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnStepUp"
                    style="@style/Mazdash.Button.Rounded"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="&gt;"
                    android:textSize="16sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnSeekUp"
                    style="@style/Mazdash.Button.Rounded"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="&gt;&gt;"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Right Column: Presets P1 - P6 -->
        <LinearLayout
            style="@style/Mazdash.Card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Mazdash.Text.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ZAPISANE STACJE (PRZYTRZYMAJ, ABY ZAPISAĆ)"
                android:layout_marginBottom="8dp" />

            <GridLayout
                android:id="@+id/gridPresets"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:columnCount="2"
                android:rowCount="3"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="true">

                <!-- Preset P1 -->
                <LinearLayout
                    android:id="@+id/preset1"
                    style="@style/Mazdash.Tile"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/p1Freq"
                        style="@style/Mazdash.Text.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="105.60"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/p1Name"
                        style="@style/Mazdash.Text.CardSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="P1 - RMF FM"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Preset P2 -->
                <LinearLayout
                    android:id="@+id/preset2"
                    style="@style/Mazdash.Tile"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/p2Freq"
                        style="@style/Mazdash.Text.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="107.50"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/p2Name"
                        style="@style/Mazdash.Text.CardSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="P2 - Radio ZET"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Preset P3 -->
                <LinearLayout
                    android:id="@+id/preset3"
                    style="@style/Mazdash.Tile"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/p3Freq"
                        style="@style/Mazdash.Text.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="98.80"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/p3Name"
                        style="@style/Mazdash.Text.CardSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="P3 - ESKA"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Preset P4 -->
                <LinearLayout
                    android:id="@+id/preset4"
                    style="@style/Mazdash.Tile"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/p4Freq"
                        style="@style/Mazdash.Text.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="90.30"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/p4Name"
                        style="@style/Mazdash.Text.CardSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="P4 - Trójka"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Preset P5 -->
                <LinearLayout
                    android:id="@+id/preset5"
                    style="@style/Mazdash.Tile"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/p5Freq"
                        style="@style/Mazdash.Text.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="101.00"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/p5Name"
                        style="@style/Mazdash.Text.CardSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="P5 - Jedynka"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Preset P6 -->
                <LinearLayout
                    android:id="@+id/preset6"
                    style="@style/Mazdash.Tile"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/p6Freq"
                        style="@style/Mazdash.Text.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="103.00"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/p6Name"
                        style="@style/Mazdash.Text.CardSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="P6 - Antyradio"
                        android:textSize="11sp" />
                </LinearLayout>

            </GridLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
