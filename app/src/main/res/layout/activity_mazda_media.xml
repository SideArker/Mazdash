<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Top Navigation Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bar"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/navBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_back"
            app:srcCompat="@drawable/ic_back" />

        <TextView
            android:id="@+id/pageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/mazda_media_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Sound DSP Shortcut -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnOpenDsp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mazda_dsp_title"
            app:srcCompat="@drawable/ic_equalizer" />

        <!-- Bluetooth Manager Shortcut -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnOpenBluetooth"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mazda_bt_title"
            app:srcCompat="@drawable/ic_bluetooth" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/navHome"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_home"
            app:srcCompat="@drawable/ic_home" />

    </LinearLayout>

    <!-- Main Content Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <!-- Active Media Player View -->
        <LinearLayout
            android:id="@+id/layoutPlaying"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_dark"
            android:padding="20dp"
            android:visibility="visible">

            <!-- Large Audio Visualizer Bars -->
            <com.dashline.launcher.AudioVisualizerView
                android:id="@+id/largeVisualizer"
                android:layout_width="260dp"
                android:layout_height="80dp"
                android:layout_marginBottom="16dp" />

            <!-- Song Title -->
            <TextView
                android:id="@+id/textMediaTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="600dp"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="Odtwarzanie Bluetooth"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="4dp" />

            <!-- Artist / Album -->
            <TextView
                android:id="@+id/textMediaArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="600dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Gotowy do odtwarzania"
                android:textColor="@color/text_secondary"
                android:textSize="17sp"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <!-- Source Device Badge -->
            <TextView
                android:id="@+id/textMediaSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_circle"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Bluetooth Audio"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:layout_marginBottom="20dp" />

            <!-- Transport Playback Controls -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Previous Track -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnPrev"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="14dp"
                    android:background="@drawable/btn_circle"
                    android:contentDescription="@string/media_previous"
                    app:srcCompat="@drawable/ic_skip_previous"
                    app:tint="@android:color/white"
                    android:layout_marginEnd="16dp" />

                <!-- Play / Pause -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnPlayPause"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:padding="18dp"
                    android:background="@drawable/btn_circle"
                    android:backgroundTint="#C41230"
                    android:contentDescription="@string/media_play_pause"
                    app:srcCompat="@drawable/ic_play"
                    app:tint="@android:color/white"
                    android:layout_marginEnd="16dp" />

                <!-- Next Track -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnNext"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="14dp"
                    android:background="@drawable/btn_circle"
                    android:contentDescription="@string/media_next"
                    app:srcCompat="@drawable/ic_skip_next"
                    app:tint="@android:color/white" />

            </LinearLayout>

        </LinearLayout>

        <!-- No Connection Prompt View -->
        <LinearLayout
            android:id="@+id/layoutNotConnected"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_dark"
            android:padding="24dp"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:padding="12dp"
                app:srcCompat="@drawable/ic_bluetooth"
                app:tint="#C41230"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/media_not_connected_title"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="480dp"
                android:text="@string/media_not_connected_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnPairPhone"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/media_btn_pair"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/btn_circle"
                android:backgroundTint="#C41230" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
