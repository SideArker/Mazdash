<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Top Navigation Header -->
    <LinearLayout
        style="@style/Mazdash.Header">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/navBack"
            style="@style/Mazdash.Button.Icon"
            android:contentDescription="@string/nav_back"
            app:srcCompat="@drawable/ic_back" />

        <TextView
            android:id="@+id/pageTitle"
            style="@style/Mazdash.Text.HeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="@string/mazda_media_title" />

        <!-- Sound DSP Shortcut -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnOpenDsp"
            style="@style/Mazdash.Button.Icon"
            android:contentDescription="@string/mazda_dsp_title"
            app:srcCompat="@drawable/ic_equalizer" />

        <!-- Bluetooth Manager Shortcut -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnOpenBluetooth"
            style="@style/Mazdash.Button.Icon"
            android:contentDescription="@string/mazda_bt_title"
            app:srcCompat="@drawable/ic_bluetooth" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/navHome"
            style="@style/Mazdash.Button.Icon"
            android:contentDescription="@string/nav_home"
            app:srcCompat="@drawable/ic_home" />

    </LinearLayout>

    <!-- Main Content Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="14dp">

        <!-- Ambient Album Background & Scrim -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imageMediaBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0.22"
            android:visibility="gone" />

        <View
            android:id="@+id/imageMediaOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#A609090B"
            android:visibility="gone" />

        <!-- Active Media Player View (2-Column Landscape) -->
        <LinearLayout
            android:id="@+id/layoutPlaying"
            style="@style/Mazdash.Card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:visibility="visible">

            <!-- Left: Album Art Cover & Album Name -->
            <LinearLayout
                android:layout_width="220dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="20dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imageAlbumArt"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/card_dark"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/ic_audio" />

                <TextView
                    android:id="@+id/textAlbumName"
                    style="@style/Mazdash.Text.CardSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- Right: Track Metadata, 20-Bar Visualizer, Transport Controls -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/textMediaSource"
                    style="@style/Mazdash.Text.SectionLabel.Accent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bluetooth Audio"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/textTrackTitle"
                    style="@style/Mazdash.Text.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="26sp"
                    android:maxLines="1"
                    android:ellipsize="marquee"
                    android:singleLine="true"
                    android:marqueeRepeatLimit="marquee_forever" />

                <TextView
                    android:id="@+id/textTrackArtist"
                    style="@style/Mazdash.Text.CardSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:layout_marginBottom="14dp" />

                <!-- 20-Bar Large Audio Visualizer -->
                <com.dashline.launcher.AudioVisualizerView
                    android:id="@+id/largeVisualizer"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="16dp" />

                <!-- Transport Controls -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/btnPrev"
                        style="@style/Mazdash.Button.Media.Skip"
                        android:contentDescription="@string/media_previous"
                        app:srcCompat="@drawable/ic_skip_previous"
                        android:layout_marginEnd="16dp" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/btnPlayPause"
                        style="@style/Mazdash.Button.Media.Play"
                        android:contentDescription="@string/media_play_pause"
                        app:srcCompat="@drawable/ic_play"
                        android:layout_marginEnd="16dp" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/btnNext"
                        style="@style/Mazdash.Button.Media.Skip"
                        android:contentDescription="@string/media_next"
                        app:srcCompat="@drawable/ic_skip_next" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- No Connection Prompt View -->
        <LinearLayout
            android:id="@+id/layoutNotConnected"
            style="@style/Mazdash.Card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:padding="12dp"
                app:srcCompat="@drawable/ic_bluetooth"
                app:tint="@color/mz_accent"
                android:layout_marginBottom="16dp" />

            <TextView
                style="@style/Mazdash.Text.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/media_not_connected_title"
                android:textSize="22sp"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                style="@style/Mazdash.Text.CardSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="480dp"
                android:text="@string/media_not_connected_subtitle"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnPairPhone"
                style="@style/Mazdash.Button.Pill"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/media_btn_pair" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
